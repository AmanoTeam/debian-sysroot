From d7dfca34099a2c382208c27eb4005ccbafd1ac04 Mon Sep 17 00:00:00 2001
From: Your Name <you@example.com>
Date: Mon, 15 Dec 2025 20:46:02 +0100
Subject: [PATCH] Backport AArch64 HWCAP_* definitions to older glibc versions

---
 bits/hwcap.h | 14 +++++++++++++-
 1 file changed, 13 insertions(+), 1 deletion(-)

diff --git a/bits/hwcap.h b/bits/hwcap.h
index 16a26a4..b688380 100644
--- a/bits/hwcap.h
+++ b/bits/hwcap.h
@@ -20,4 +20,16 @@
 # error "Never include <bits/hwcap.h> directly; use <sys/auxv.h> instead."
 #endif
 
-/* No bits defined for this architecture.  */
+/* The following must match the kernel's <asm/hwcap.h>.  */
+#define HWCAP_FP		(1 << 0)
+#define HWCAP_ASIMD		(1 << 1)
+#define HWCAP_EVTSTRM		(1 << 2)
+#define HWCAP_AES		(1 << 3)
+#define HWCAP_PMULL		(1 << 4)
+#define HWCAP_SHA1		(1 << 5)
+#define HWCAP_SHA2		(1 << 6)
+#define HWCAP_CRC32		(1 << 7)
+#define HWCAP_ATOMICS		(1 << 8)
+#define HWCAP_FPHP		(1 << 9)
+#define HWCAP_ASIMDHP		(1 << 10)
+
-- 
